# Neon DB connection string (get from Neon dashboard → Connection Details → Connection string)
# Use the "pooled" connection string for production
DATABASE_URL=postgresql+psycopg2://user:password@ep-xxx.aws.neon.tech/neondb?sslmode=require&channel_binding=require

# Generate a strong random secret for JWT signing
# Run: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=supersecretkey-change-me-in-production

# Comma-separated list of allowed frontend origins
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
